    {
      "name": "Смерть питомца",
      "item": [
        {
          "name": "14. Создать питомца с life=1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"dyingPetId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Шарик\",\n  \"life\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pets"]
            },
            "description": "Создаёт питомца с life=1, id сохраняется в переменную dyingPetId."
          }
        },
        {
          "name": "15. ignore — счастье снижается до 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Счастье снизилось до 1\", function () {",
                  "    pm.expect(pm.response.json().happiness).to.eql(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"ignore\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pets/{{dyingPetId}}/actions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pets", "{{dyingPetId}}", "actions"]
            }
