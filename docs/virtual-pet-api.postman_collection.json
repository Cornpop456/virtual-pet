              "path": ["api", "v1", "pets", "not-an-id"]
            }
          }
        },
        {
          "name": "10. Получение: несуществующий питомец",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Случайный ObjectId: id заведомо не существует в базе",
                  "let missingId = \"\";",
                  "for (let i = 0; i < 24; i++) {",
                  "    missingId += \"0123456789abcdef\"[Math.floor(Math.random() * 16)];",
                  "}",
                  "pm.collectionVariables.set(\"missingId\", missingId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test(\"Текст ошибки\", function () {",
                  "    pm.expect(pm.response.json().error).to.eql(\"Такого питомца нет\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pets/{{missingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pets", "{{missingId}}"]
            }
          }
        },
